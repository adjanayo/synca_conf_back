# Copy this file to .env and fill in real values. Never commit .env.
# Passwords below must be 12+ characters with mixed case, a digit, and a symbol.
# Generate one with: python3 -c "import secrets,string; a=string.ascii_letters+string.digits+'!@#%^&*()-_=+'; print(''.join(secrets.choice(a) for _ in range(20)))"

# Environment: "local" or "production". Controls whether API docs
# (/docs, /redoc, /openapi.json) are served at all — never "production"
# outside an actual production deploy.
ENVIRONMENT=local

# PostgreSQL
POSTGRES_USER=synca
POSTGRES_PASSWORD=change-me-strong-12+chars-mixed-case-digit-symbol
POSTGRES_DB=synca
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=synca
MINIO_ROOT_PASSWORD=change-me-strong-12+chars-mixed-case-digit-symbol
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# JWT signing key. Generate one with the same command as the
# passwords above — never reuse a password as the signing key.
JWT_SECRET_KEY=change-me-strong-random-signing-key

# Fernet key for customer PII encryption — must be a real Fernet key:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-generate-a-real-fernet-key

# Mailpit — dev-only SMTP catch-all
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=dev@synca.local
