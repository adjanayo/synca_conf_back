# Copier en .env pour le dev local — jamais commiter .env (voir .gitignore)

ENVIRONMENT=local

# Caddy (docker-compose.prod.yml) — domaine réel en production, :80 en local pour tester sans cert
DOMAIN=:80

# MySQL — consommé à la fois par le conteneur mysql (MYSQL_*) et par
# app/core/config.py (mysql_user/mysql_password/mysql_database, lecture
# insensible à la casse). DB_HOST/DB_PORT ont des défauts corrects pour
# docker-compose (service "db") — à ne surcharger qu'en dehors de Docker.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=syncaconf
MYSQL_USER=syncaconf
MYSQL_PASSWORD=change-me-app
# DB_HOST=db
# DB_PORT=3306

# JWT (app/services/auth_service.py) — générer une vraie valeur en prod :
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production-min-32-bytes-long

# Chiffrement PII (app/core/crypto.py, 7.8) — clé Fernet valide requise (pas
# une chaîne libre comme JWT_SECRET_KEY). Générer une vraie valeur en prod :
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# La valeur ci-dessous n'est utilisable qu'en dev local — jamais en prod.
FERNET_KEY=j39m9PIVfPgM-5Vr1jBEExHbmi5S3i2URMynbgd1pSo=

# CORS (app/main.py) — liste blanche exacte, jamais de wildcard "*" en prod.
# Origines de dev par défaut (Next.js/Vite) ; remplacer par le vrai domaine
# du frontend en production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Lieu de l'événement, imprimé sur le billet (app/services/ticket_pdf.py).
# À renseigner dès que le lieu est confirmé.
EVENT_VENUE=Lieu à confirmer

# Superadmin initial (app/cli/create_admin.py) — consommé par
# `make create-admin`. Aucune valeur par défaut : le script refuse de
# tourner si ces variables manquent. Choisir un mot de passe fort en
# production ; en dev local un mot de passe simple suffit.
ADMIN_EMAIL=admin@synca.conf
ADMIN_PASSWORD=ChangeMe123!

# reCAPTCHA v3 (app/services/recaptcha.py) — vide = vérification désactivée
# silencieusement (mode dev/CI, pas de credentials Google réels). En
# production, une clé manquante désactive la protection anti-bot des
# formulaires publics SANS erreur visible — vérifier explicitement sa
# présence avant tout déploiement prod (voir DEPLOYMENT.md).
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# JWT participant (login OTP, app/api/participant_auth.py) — durée de vie du
# token émis par POST /api/auth/otp/verify. Distinct de l'access_token admin.
PARTICIPANT_TOKEN_EXPIRE_HOURS=24

# Stockage fichiers (app/services/storage.py). Trois backends :
# - "minio" (recommandé, dev ET prod) : MinIO auto-hébergé, S3-compatible,
#   dans son propre conteneur + volume Docker nommé (docker-compose.yml /
#   docker-compose.prod.yml). Rendre le bucket public est un simple appel API
#   gratuit ici, contrairement à B2 (voir ci-dessous). En dev, le backend
#   parle à MinIO en direct (MINIO_ENDPOINT_URL=http://minio:9000, réseau
#   compose interne) et sert les fichiers via le port hôte publié
#   (MINIO_PUBLIC_URL=http://localhost:9010). En prod, pas de port MinIO
#   publié : Caddy route /<MINIO_BUCKET_NAME>/* vers minio:9000 (voir
#   Caddyfile), donc MINIO_PUBLIC_URL=https://<domaine>.
# - "local" : écrit sur disque, servi par le backend lui-même via /uploads
#   (volume ./uploads, voir docker-compose.yml). Aucun conteneur/compte
#   requis — filet de secours (ex. CI/tests), plus le mode actif par défaut.
# - "b2" : Backblaze B2 (S3-compatible). Free tier 10 Go + egress gratuit,
#   mais rendre un bucket PUBLIC (nécessaire pour que les photos/logos
#   s'affichent sur le site) est une fonctionnalité payante sur certains
#   comptes B2 — voir BACKBLAZE_SETUP.md avant de basculer dessus.
STORAGE_BACKEND=minio
MINIO_ROOT_USER=<utilisateur admin MinIO, ex. synca_minio>
MINIO_ROOT_PASSWORD=<mot de passe admin MinIO, généré aléatoirement>
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_ACCESS_KEY=<= MINIO_ROOT_USER>
MINIO_SECRET_KEY=<= MINIO_ROOT_PASSWORD>
MINIO_BUCKET_NAME=synca-dev
MINIO_PUBLIC_URL=http://localhost:9010

LOCAL_UPLOAD_DIR=/app/uploads
LOCAL_PUBLIC_BASE_URL=http://127.0.0.1:8010

# Variables B2, utilisées seulement si STORAGE_BACKEND=b2.
B2_ENDPOINT_URL=https://s3.<region>.backblazeb2.com
B2_KEY_ID=<applicationKeyId du bucket synca-dev>
B2_APPLICATION_KEY=<applicationKey du bucket synca-dev>
B2_BUCKET_NAME=synca-dev
B2_PUBLIC_URL=<url publique du bucket synca-dev>
